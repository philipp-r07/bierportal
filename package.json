{
  "name": "webeng-projekt",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "scripts": {
    "docker:up": "docker-compose --env-file .env -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose --env-file .env -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose --env-file .env -f docker/docker-compose.yml logs -f",
    "backend:build": "nx build backend",
    "backend:start": "node dist/apps/backend/main.js",
    "backend:start:dev": "nx build backend && node dist/apps/backend/main.js",
    "backend:test": "nx test backend",
    "backend:lint": "nx lint backend",
    "backend:lint:fix": "nx lint backend --fix",
    "frontend:build": "nx build frontend",
    "frontend:start": "nx serve frontend",
    "frontend:test": "nx test frontend",
    "frontend:lint": "nx lint frontend",
    "frontend:lint:fix": "nx lint frontend --fix",
    "lint": "nx lint frontend && nx lint backend",
    "lint:fix": "nx lint frontend --fix && nx lint backend --fix",
    "test": "nx test backend && nx test frontend",
    "build": "nx build backend && nx build frontend",
    "typeorm": "ts-node -r tsconfig-paths/register --transpile-only --project apps/backend/tsconfig.app.json node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d apps/backend/src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d apps/backend/src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d apps/backend/src/database/data-source.ts",
    "backend:seed": "ts-node -r tsconfig-paths/register --transpile-only --project apps/backend/tsconfig.app.json apps/backend/src/database/seeds/seed.ts"
  },
  "dependencies": {
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/platform-browser": "^21.2.9",
    "@angular/platform-browser-dynamic": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.2.1",
    "multer": "^2.3.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.29",
    "zone.js": "^0.16.2"
  },
  "overrides": {
    "nx": {
      "follow-redirects": "^1.16.0"
    },
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/jest": "23.3.0",
    "@nx/nest": "23.3.0",
    "@nx/node": "23.3.0",
    "@nx/webpack": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.2",
    "jsdom": "^30.1.2",
    "nx": "22.7.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  }
}
